---
// Projects: an engineering drawing that sketches itself, with one station per
// project on a shared line. It reads the project list, so a new project appears
// automatically: known projects get their own drawing, others a plain octagon.
import { projects } from "@/data/projects";

const TOP = 72;
// Leaves room below the last station for the tallest drawing (TERRA's double wave) above the ruler.
const BOTTOM = 416;
const GLYPH_X = 80;
const LABEL_X = 315;

const stations = projects.map((project, index) => ({
  project,
  short: project.name.replace("Project ", ""),
  y: projects.length === 1 ? (TOP + BOTTOM) / 2 : TOP + (index * (BOTTOM - TOP)) / (projects.length - 1),
  // Each station starts drawing a little after the one above it.
  d: 0.5 + index * 0.9,
}));

const corners = ["M18 46V18H46", "M454 18H482V46", "M482 454V482H454", "M46 482H18V454"];
const ticks = Array.from({ length: 21 }, (_, i) => 50 + i * 20);
const bus = `M36 ${TOP - 32}V${BOTTOM}`;
---

<svg class="blueprint" viewBox="0 0 500 500">
  <g class="blueprint__frame">
    {corners.map((d) => <path d={d} />)}
    {ticks.map((x, i) => <line x1={x} y1="482" x2={x} y2={i % 5 === 0 ? 472 : 477} />)}
  </g>

  <path class="draw bus" pathLength="1" d={bus} style="--d: 0" />
  <path class="blueprint__run" pathLength="1" d={bus} />

  {
    stations.map(({ project, short, y, d }) => (
      <g style={{ "--c": project.accent }}>
        <path class="draw branch" pathLength="1" d={`M36 ${y}H${GLYPH_X - 2}`} style={{ "--d": d }} />
        <rect class="blueprint__joint" x="32" y={y - 4} width="8" height="8" />

        <g transform={`translate(${GLYPH_X} ${y})`}>
          {project.slug === "terra" ? (
            <>
              <path class="draw stroke" pathLength="1" d="M0 0C33 -26 67 -26 100 0S167 26 200 0" style={{ "--d": d + 0.4 }} />
              <path class="draw stroke faint" pathLength="1" d="M0 18C33 -8 67 -8 100 18S167 44 200 18" style={{ "--d": d + 0.7 }} />
              <path class="draw stroke faint" pathLength="1" d="M100 -38V-10" style={{ "--d": d + 0.9 }} />
              <circle class="ping" cx="100" cy="-42" r="12" />
              <circle class="solid" cx="100" cy="-42" r="4" />
            </>
          ) : project.slug === "sunagorik" ? (
            <>
              <path class="draw stroke" pathLength="1" d="M0 0H70L84 -30L102 34L118 -20L128 0H200" style={{ "--d": d + 0.4 }} />
              <circle class="ping" cx="200" cy="0" r="12" style="animation-delay: 1.2s" />
              <circle class="solid" cx="200" cy="0" r="4" />
            </>
          ) : project.slug === "barios" ? (
            <>
              <polygon class="draw stroke" pathLength="1" points="60,-36 91,-18 91,18 60,36 29,18 29,-18" style={{ "--d": d + 0.4 }} />
              <polygon class="draw stroke faint" pathLength="1" points="60,-20 77,-10 77,10 60,20 43,10 43,-10" style={{ "--d": d + 0.8 }} />
              <path class="draw stroke faint" pathLength="1" d="M0 0H29M91 0H200" style={{ "--d": d + 1 }} />
            </>
          ) : project.slug === "aeroaid" ? (
            <>
              <circle class="ping" cx="60" cy="0" r="30" style="animation-delay: 0.6s" />
              <circle class="draw stroke" pathLength="1" cx="60" cy="0" r="30" style={{ "--d": d + 0.4 }} />
              <path class="draw stroke faint" pathLength="1" d="M60 -19 77 13H43Z" style={{ "--d": d + 0.8 }} />
              <path class="draw stroke beat" pathLength="1" d="M60 -9V9M51 0H69" style={{ "--d": d + 1 }} />
              <path class="draw stroke faint" pathLength="1" d="M0 0H30M90 0H124L132 -14L142 14L150 0H200" style={{ "--d": d + 1.1 }} />
            </>
          ) : (
            <polygon class="draw stroke" pathLength="1" points="48,-30 72,-30 90,-12 90,12 72,30 48,30 30,12 30,-12" style={{ "--d": d + 0.4 }} />
          )}
        </g>

        <g class="note" style={{ "--d": d + 1.2 }}>
          <text class="note__title" x={LABEL_X} y={y - 3}>{short}</text>
          <text class="note__text" x={LABEL_X} y={y + 15}>{project.field}</text>
        </g>
      </g>
    ))
  }
</svg>

<style>
  .blueprint {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .blueprint__frame {
    fill: none;
    stroke: var(--line-strong);
  }

  .draw {
    fill: none;
    stroke-dasharray: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: blueprint-draw 15s ease-in-out infinite backwards;
    animation-delay: calc(var(--d) * 1s);
  }

  .bus,
  .branch {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .stroke {
    stroke: var(--c);
    stroke-width: 2;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--c) 50%, transparent));
  }

  .faint {
    stroke-width: 1.25;
    opacity: 0.55;
    filter: none;
  }

  /* The light that keeps running along the shared line. */
  .blueprint__run {
    fill: none;
    stroke: var(--lime);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 0.1 0.9;
    animation: blueprint-run 3.6s linear infinite;
  }

  .blueprint__joint {
    fill: var(--ink);
    stroke: var(--lime);
  }

  .solid {
    fill: var(--c);
  }

  .beat {
    transform-box: fill-box;
    transform-origin: center;
    animation:
      blueprint-draw 15s ease-in-out infinite backwards,
      blueprint-beat 2.4s ease-out infinite;
    animation-delay: calc(var(--d) * 1s), 0s;
  }

  @keyframes blueprint-beat {
    0%,
    31%,
    100% {
      scale: 1;
    }

    6% {
      scale: 1.35;
    }

    20% {
      scale: 1.15;
    }
  }

  .ping {
    fill: none;
    stroke: var(--c);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: blueprint-ping 3s ease-out infinite;
  }

  .note {
    animation: blueprint-note 15s ease-in-out infinite backwards;
    animation-delay: calc(var(--d) * 1s);
  }

  .note__title {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .note__text {
    fill: var(--c);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @keyframes blueprint-draw {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }

    14%,
    72% {
      stroke-dashoffset: 0;
    }

    80% {
      opacity: 1;
    }

    90%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes blueprint-note {
    0%,
    6% {
      opacity: 0;
    }

    14%,
    80% {
      opacity: 1;
    }

    90%,
    100% {
      opacity: 0;
    }
  }

  @keyframes blueprint-run {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes blueprint-ping {
    from {
      opacity: 0.8;
      transform: scale(0.35);
    }

    to {
      opacity: 0;
      transform: scale(1.5);
    }
  }
</style>
